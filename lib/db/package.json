{
  "name": "@workspace/db",
  "version": "0.0.0",
  "description": "Drizzle ORM + PostgreSQL database client for artifacts/api-server ONLY. NOT used by artifacts/budget-app (which has its own Prisma + SQLite layer at artifacts/budget-app/src/lib/db.ts).",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.20.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.18.0",
    "drizzle-kit": "^0.31.9"
  }
}
