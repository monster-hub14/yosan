generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum BudgetType {
  SHARED
  SOLO
}

enum BudgetMemberRole {
  ADMIN
  MEMBER
}

enum BudgetShareRole {
  VIEWER
  HELPER
  CO_OWNER
}

enum PayFrequency {
  WEEKLY
  BIWEEKLY
  SEMIMONTHLY
  MONTHLY
  QUARTERLY
  ANNUALLY
  CUSTOM
}

enum ExpenseFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY
}

enum AIProvider {
  OPENAI
  ANTHROPIC
  GOOGLE
  OLLAMA
  CUSTOM
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  NEEDS_REVIEW
  SAVED_FOR_LATER
  CONFIRMED
  DISCARDED
}

enum InsightType {
  SPENDING_SPIKE
  SAVINGS_OPPORTUNITY
  BUDGET_ALERT
  FORECAST
  TIP
}

enum NotificationChannel {
  EMAIL
  IN_APP
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(USER)
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedBudgets          Budget[]
  budgetMemberships     BudgetMembership[]
  uploadedReceipts      Receipt[]
  incomeEntries         IncomeEntry[]
  notificationPrefs     NotificationPreference[]
  pendingImports        PendingImport[]
  confirmedImports      PendingImport[] @relation("ConfirmedImports")
  soloShares            BudgetSoloShare[]
  aiUsageLogs           AIUsageLog[]
  aiControl             UserAIControl?
  addedExpenses         Expense[]       @relation("AddedExpenses")
}

model Budget {
  id          String     @id @default(cuid())
  name        String
  currency    String     @default("USD")
  description String?
  ownerId     String
  budgetType  BudgetType @default(SHARED)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  owner                 User                    @relation(fields: [ownerId], references: [id])
  memberships           BudgetMembership[]
  soloShares            BudgetSoloShare[]
  incomeSources         IncomeSource[]
  incomeEntries         IncomeEntry[]
  savingsGoals          SavingsGoal[]
  recurringExpenses     RecurringExpense[]
  expenses              Expense[]
  receipts              Receipt[]
  categories            Category[]
  merchantMemories      MerchantMemory[]
  itemMemories          ItemMemory[]
  forecastSnapshots     ForecastSnapshot[]
  insights              Insight[]
  notificationPrefs     NotificationPreference[]
  emailForwarding       EmailForwardingConfig?
  pendingImports        PendingImport[]
}

model BudgetMembership {
  id        String           @id @default(cuid())
  budgetId  String
  userId    String
  role      BudgetMemberRole @default(MEMBER)
  createdAt DateTime         @default(now())

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([budgetId, userId])
}

model BudgetSoloShare {
  id          String          @id @default(cuid())
  budgetId    String
  userId      String?
  shareToken  String          @unique @default(cuid())
  role        BudgetShareRole @default(VIEWER)
  label       String?
  expiresAt   DateTime?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model IncomeSource {
  id          String       @id @default(cuid())
  budgetId    String
  name        String
  amount      Float
  frequency   PayFrequency @default(BIWEEKLY)
  customDays  Int?
  nextPayDate DateTime?
  isActive    Boolean      @default(true)
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  budget        Budget        @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  incomeEntries IncomeEntry[]
}

model IncomeEntry {
  id             String   @id @default(cuid())
  budgetId       String
  incomeSourceId String?
  userId         String
  amount         Float
  date           DateTime
  note           String?
  createdAt      DateTime @default(now())

  budget       Budget        @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  incomeSource IncomeSource? @relation(fields: [incomeSourceId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
}

model SavingsGoal {
  id                String    @id @default(cuid())
  budgetId          String
  name              String
  targetAmount      Float
  currentAmount     Float     @default(0)
  perPaycheckAmount Float?
  isMonthlyGoal     Boolean   @default(false)
  targetDate        DateTime?
  isActive          Boolean   @default(true)
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
}

model RecurringExpense {
  id          String           @id @default(cuid())
  budgetId    String
  categoryId  String?
  name        String
  amount      Float
  frequency   ExpenseFrequency @default(MONTHLY)
  nextDueDate DateTime?
  isActive    Boolean          @default(true)
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  budget   Budget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])
}

model Expense {
  id          String   @id @default(cuid())
  budgetId    String
  categoryId  String?
  addedById   String?
  amount      Float
  currency    String   @default("USD")
  date        DateTime
  description String?
  merchant    String?
  notes       String?
  receiptId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  budget       Budget        @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category     Category?     @relation(fields: [categoryId], references: [id])
  receipt      Receipt?      @relation(fields: [receiptId], references: [id])
  addedBy      User?         @relation("AddedExpenses", fields: [addedById], references: [id])
  receiptItems ReceiptItem[]
  pendingImport PendingImport?
}

model Receipt {
  id               String      @id @default(cuid())
  budgetId         String
  uploadedById     String
  originalFilename String
  storedFilename   String
  mimeType         String
  fileSize         Int?
  uploadedAt       DateTime    @default(now())
  processedAt      DateTime?
  rawText          String?
  totalAmount      Float?
  merchantName     String?
  receiptDate      DateTime?
  status           ImportStatus @default(PENDING)
  errorMessage     String?

  budget           Budget               @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  uploadedBy       User                 @relation(fields: [uploadedById], references: [id])
  receiptItems     ReceiptItem[]
  expenses         Expense[]
  clarifications   ClarificationHistory[]
  pendingImports   PendingImport[]
}

model ReceiptItem {
  id         String  @id @default(cuid())
  receiptId  String
  expenseId  String?
  name       String
  price      Float
  quantity   Float   @default(1)
  totalPrice Float?
  category   String?
  notes      String?

  receipt Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  expense Expense? @relation(fields: [expenseId], references: [id])
}

model Category {
  id        String   @id @default(cuid())
  budgetId  String?
  name      String
  color     String?
  icon      String?
  isDefault Boolean  @default(false)
  parentId  String?
  createdAt DateTime @default(now())

  budget           Budget?           @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  parent           Category?         @relation("CategoryChildren", fields: [parentId], references: [id])
  children         Category[]        @relation("CategoryChildren")
  expenses         Expense[]
  recurringExpenses RecurringExpense[]
  merchantMemories MerchantMemory[]
  itemMemories     ItemMemory[]
}

model MerchantMemory {
  id                String   @id @default(cuid())
  budgetId          String
  merchantName      String
  defaultCategoryId String?
  lastUsedAt        DateTime @default(now())

  budget          Budget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  defaultCategory Category? @relation(fields: [defaultCategoryId], references: [id])

  @@unique([budgetId, merchantName])
}

model ItemMemory {
  id                String   @id @default(cuid())
  budgetId          String
  itemName          String
  defaultCategoryId String?
  aliases           String   @default("")
  lastUsedAt        DateTime @default(now())
  /// When true: AI flagged this item as ambiguous. Re-present clarification prompt next time.
  isAmbiguous       Boolean  @default(false)
  /// The clarification question to show when isAmbiguous is true.
  ambiguousQuestion String?

  budget          Budget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  defaultCategory Category? @relation(fields: [defaultCategoryId], references: [id])

  @@unique([budgetId, itemName])
}

model ClarificationHistory {
  id        String   @id @default(cuid())
  receiptId String?
  question  String
  answer    String
  context   String?
  createdAt DateTime @default(now())

  receipt Receipt? @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}

model ForecastSnapshot {
  id           String   @id @default(cuid())
  budgetId     String
  forecastDate DateTime
  data         String
  createdAt    DateTime @default(now())

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
}

model Insight {
  id        String      @id @default(cuid())
  budgetId  String
  type      InsightType
  title     String
  body      String
  severity  String      @default("info")
  metadata  String      @default("{}")
  isRead    Boolean     @default(false)
  createdAt DateTime    @default(now())

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
}

model NotificationPreference {
  id        String              @id @default(cuid())
  userId    String
  budgetId  String?
  channel   NotificationChannel
  event     String
  isEnabled Boolean             @default(true)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  budget Budget? @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([userId, budgetId, channel, event])
}

enum AIFeature {
  EXTRACTION
  CATEGORIZATION
  RECURRING_CATEGORIZATION
  INSIGHTS
  FORECASTING
}

model AIProviderConfig {
  id        String     @id @default("singleton")
  provider  AIProvider @default(OPENAI)
  model     String     @default("gpt-4o-mini")
  apiKey    String?
  baseUrl   String?
  isEnabled Boolean    @default(false)

  extractionEnabled            Boolean @default(true)
  categorizationEnabled        Boolean @default(true)
  recurringCategorizationEnabled Boolean @default(true)
  insightsEnabled              Boolean @default(true)
  forecastingEnabled           Boolean @default(false)

  dailyLimitPerUser   Int? @default(50)
  weeklyLimitPerUser  Int? @default(200)
  monthlyLimitPerUser Int? @default(500)

  updatedAt DateTime @updatedAt
}

model AIUsageLog {
  id          String    @id @default(cuid())
  userId      String
  feature     String
  createdAt   DateTime  @default(now())
  windowDate  String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, feature, windowDate])
}

/// Per-user AI feature overrides managed by admins.
/// NULL on a limit field means "use the global default from AIProviderConfig".
/// aiEnabled=false hard-disables AI for this user regardless of global setting.
model UserAIControl {
  id                  String   @id @default(cuid())
  userId              String   @unique
  aiEnabled           Boolean  @default(true)
  extractionEnabled   Boolean  @default(true)
  categorizationEnabled Boolean @default(true)
  dailyLimit          Int?
  weeklyLimit         Int?
  monthlyLimit        Int?
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailConfig {
  id          String   @id @default("singleton")
  smtpHost    String?
  smtpPort    Int      @default(587)
  smtpUser    String?
  smtpPass    String?
  fromAddress String?
  fromName    String   @default("Budget App")
  isEnabled   Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

model EmailForwardingConfig {
  id             String   @id @default(cuid())
  budgetId       String   @unique
  inboundAddress String   @unique
  isEnabled      Boolean  @default(true)
  updatedAt      DateTime @updatedAt

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
}

model PendingImport {
  id              String       @id @default(cuid())
  budgetId        String
  userId          String
  receiptId       String?
  expenseId       String?      @unique
  confirmedById   String?
  confirmedAt     DateTime?
  status          ImportStatus @default(PENDING)
  data            String       @default("{}")
  error           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  budget      Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])
  receipt     Receipt? @relation(fields: [receiptId], references: [id])
  confirmedBy User?    @relation("ConfirmedImports", fields: [confirmedById], references: [id])
  expense     Expense? @relation(fields: [expenseId], references: [id])
}

model SetupProgress {
  id                  String    @id @default("singleton")
  adminAccountCreated Boolean   @default(false)
  firstBudgetCreated  Boolean   @default(false)
  incomeConfigured    Boolean   @default(false)
  savingsConfigured   Boolean   @default(false)
  recurringConfigured Boolean   @default(false)
  aiConfigured        Boolean   @default(false)
  emailConfigured     Boolean   @default(false)
  completedAt         DateTime?
  updatedAt           DateTime  @updatedAt
}
