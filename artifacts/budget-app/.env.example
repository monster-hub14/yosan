# Yosan AI — Environment Variable Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env (or .env.local) and fill in the values below.
# For Docker deployments, pass these as environment variables in your
# docker-compose.yml or container runtime — do NOT bake secrets into the image.
#
# Generate secure random values with:
#   openssl rand -base64 48
# ─────────────────────────────────────────────────────────────────────────────

# ── Required secrets ─────────────────────────────────────────────────────────

# Signs session tokens. Must be at least 32 characters. Never reuse across deployments.
JWT_SECRET=replace_me_with_a_random_secret

# AES-256 encryption key for stored SMTP passwords and AI API keys.
# Falls back to JWT_SECRET if not set, but setting this separately is strongly recommended.
# Losing this key means stored credentials can no longer be decrypted.
ENCRYPTION_KEY=replace_me_with_a_random_secret

# Bearer token for internal cron endpoints (/api/cron/alerts, /api/cron/gmail-sync).
# Must be kept secret — anyone with this token can trigger alert emails and Gmail syncs.
CRON_SECRET=replace_me_with_a_random_secret

# ── Database ─────────────────────────────────────────────────────────────────

# SQLite file path. This is the production/container default — the database is
# written into the /app/data volume mount inside the container.
# For local development (outside Docker), override to a relative path, e.g.:
#   DATABASE_URL="file:./data/budget.db"
DATABASE_URL="file:/app/data/budget.db"

# ── Application ───────────────────────────────────────────────────────────────

# Port the web server listens on.
PORT=3000

# Directory for uploaded receipt images.
# Docker default is /app/uploads (set by docker-compose.yml).
UPLOAD_DIR="./uploads"

# ── Optional ─────────────────────────────────────────────────────────────────

# Public HTTPS origin of your app (no trailing slash, no path).
# Required for Gmail OAuth to work — Google rejects non-HTTPS redirect URIs.
# Leave empty if you are not using Gmail integration.
APP_BASE_URL=

# External URL for the email logo image shown in outgoing notification emails.
# Must be a publicly reachable HTTPS URL. Leave empty to send emails without a logo.
EMAIL_LOGO_URL=
