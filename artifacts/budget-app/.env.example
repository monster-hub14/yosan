# Budget App — Environment Variables
# Copy this file to .env.local for development, or set these in your deployment environment.

# Node environment: "development", "test", or "production"
NODE_ENV=production

# Database (SQLite — path within container or on host)
# For Docker: use /app/data/budget.db
# For bare-metal dev: use file:./data/budget.db
DATABASE_URL="file:/app/data/budget.db"

# JWT secret for session tokens — use a long random string in production
# Generate with: openssl rand -base64 48
# IMPORTANT: Separate from ENCRYPTION_KEY (see below)
JWT_SECRET="change-me-to-a-long-random-secret-before-deploying"

# Encryption key for sensitive config (API keys, SMTP passwords, Gmail tokens)
# REQUIRED IN PRODUCTION. Do not use JWT_SECRET for encryption.
# Keep separate to allow independent rotation without breaking decryption.
# Generate with: openssl rand -base64 48
# WARNING: Rotating this key will make existing encrypted secrets unrecoverable
# unless you perform a manual migration/re-encryption step (see docs).
ENCRYPTION_KEY="change-me-to-a-long-random-secret-before-deploying"

# Port the web server binds to
PORT=3000

# Base path — leave as "/" for root-mounted deployments
BASE_PATH="/"

# File upload directory (receipts)
# For Docker: /app/uploads (bind-mounted from host)
# For bare-metal dev: ./uploads
UPLOAD_DIR="/app/uploads"

# Public HTTPS origin of your app — required for Gmail OAuth to work correctly.
# Must be an HTTPS URL with no path and no trailing slash.
# Without this, Gmail OAuth redirect URIs may resolve to an internal HTTP address
# that Google will reject.
# APP_BASE_URL="https://yourdomain.com"
