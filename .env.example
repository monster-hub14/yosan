# ============================================================
# Budget App — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# JWT secret key — MUST be at least 32 random characters
# Generate with: openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-secret-key

# Database path (SQLite)
# In Docker, this maps to the /data volume
DATABASE_URL=file:/data/budget.db

# Upload directory for receipts
# In Docker, this maps to the /uploads volume
UPLOAD_DIR=/uploads

# Port the application listens on
PORT=3000

# Exposed host port (docker-compose only)
# Change if port 3000 is already in use on your host
HOST_PORT=3000

# Optional: Allowed hosts (Next.js — leave blank for auto-detection)
# NEXT_PUBLIC_BASE_URL=https://budget.yourdomain.com
